# py12306 环境变量样例（P0）
#
# 用法：
#   1. cp .env.example .env
#   2. 填上真实值（.env 已在 .gitignore / .dockerignore 里，不会进仓库也不会进镜像）
#   3. chmod 600 .env
#
# 本文件不含任何真实密钥，可以安全提交。
# 优先级：真实环境变量 > .env > 代码默认值。

# ============================================================
# 账号（必填，二选一）
# ============================================================
# 方式 A（推荐，可多账号）：
USER_ACCOUNTS_JSON=[{"username":"你的账号","password":"你的密码","login_type":"qr"},{"username":"另一个账号","password":"","login_type":"qr"}]
# 方式 B（单账号）：
# USERNAME=
# PASSWORD=
# LOGIN_TYPE=qr                # qr 扫码 / sso / password / phone

# ============================================================
# Redis（必填；P1 的 compose 会自带一个）
# ============================================================
REDIS_URL=redis://127.0.0.1:6379/0

# ============================================================
# 安全（必填）
# ============================================================
# Web 界面 JWT 密钥。绝不要用默认值。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# 登录态落盘加密口令（>=16 字符）。runtime/user 下存的是能直接下单的 cookie。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
RUNTIME_ENC_KEY=

# 显式接受明文登录态（不推荐，仅调试用）
# ALLOW_PLAINTEXT_STATE=0

# ============================================================
# 查询节奏与风控（P0 核心）
# ============================================================
QUERY_INTERVAL=4               # 基础间隔秒，建议 3~5；实际请求会带 ±30% 抖动
DEPART_PERIOD=                 # 出发时段，支持跨零点：22:00-06:00
ARRIVE_PERIOD=                 # 到达时段，同上
MAX_STATION_PAIRS=5            # 多车站组合上限，防查询量爆炸
PRE_SALE_WINDOW_MINUTES=60     # 开售前多久进入激进窗口

RISK_FAILURE_THRESHOLD=3       # 连续 N 次异常进入退避
RISK_FAILURE_BACKOFF_BASE=3    # 退避起点（秒）
RISK_FAILURE_BACKOFF_CAP=120   # 退避上限（秒）
RISK_BREAKER_BASE=30           # 熔断首次等待（秒）
RISK_BREAKER_CAP=1800          # 熔断上限（秒）= 30min
RISK_BREAKER_MULTIPLIER=2      # 熔断等待的指数倍率
RISK_SOFT_THRESHOLD=3          # 软风控信号累计阈值
RISK_JITTER_RATIO=0.2          # 所有退避/熔断等待的抖动比例

# ============================================================
# 通知（P0 只需要 console 就能看到风控告警）
# ============================================================
NOTIFY_ADAPTERS=console        # console,dingtalk,serverchan,bark,webhook（逗号分隔）
NOTIFY_CONSOLE_MIN_SEVERITY=low

DINGTALK_WEBHOOK=
DINGTALK_SECRET=               # 加签密钥，可空
DINGTALK_KEYWORD=              # 机器人安全设置里的关键词，可空
SERVERCHAN_KEY=
BARK_URL=
WEBHOOK_URL=                   # 通用 webhook，POST JSON
# WEBHOOK_HEADERS_JSON={"Authorization":"Bearer xxx"}

# ============================================================
# 日志与脱敏
# ============================================================
LOG_LEVEL=INFO
LOG_JSON=0                     # 1 = 输出 JSON 行（便于采集）
LOG_REDACT=1                   # 关闭会让你在日志里看到明文 cookie/密码，别关
# LOG_REDACT_EXTRA=SEC-\d{8};MYTOKEN-\w+   # 额外脱敏正则，分号分隔

# ============================================================
# Web 界面
# ============================================================
WEB_ENABLED=1
WEB_BIND=127.0.0.1             # 改成 0.0.0.0 必须同时配 WEB_ALLOWED_IPS
WEB_PORT=8008
WEB_ALLOWED_IPS=               # 逗号分隔的 IP 白名单
# WEB_BASIC_AUTH_USER=
# WEB_BASIC_AUTH_PASSWORD=

# ============================================================
# 目录与运行模式
# ============================================================
RUNTIME_DIR=runtime            # 登录态（敏感，独立卷）
DATA_DIR=data                  # 队列/中间数据
LOG_DIR=logs
CLIENT_MODE=both               # client / server / both
DEV_MODE=0                     # 1 会放宽密钥校验，仅本机调试
# LOAD_LEGACY_ENV=0            # 1 = 读取旧的 env.py（会有明文密钥，仅迁移期）
