# py12306 抢票助手 —— 环境变量样例
#
# 放在哪：数据目录下的 .env（程序「设置」页会显示数据目录路径），
#         也可以放在项目根目录（源码运行时）。
# 用法：
#   1. 复制本文件为 .env
#   2. 填账号与任务（下面两节必填）
#   3. 双击「启动py12306.bat」或 python app.py
#
# 本文件不含任何真实密钥，可以安全提交/分享。
# 优先级：真实环境变量 > .env > 界面设置（settings.json）> 代码默认值

# ============================================================
# 1) 账号（必填）
# ============================================================
# 推荐扫码登录（login_type=qr），不需要在配置里放密码。
USER_ACCOUNTS_JSON=[{"username":"你的12306账号","password":"","login_type":"qr"}]
# 单账号也可以拆开写：
# USERNAME=
# PASSWORD=
# LOGIN_TYPE=qr                # qr 扫码 / sso 单点 / password 账密

# ============================================================
# 2) 查询任务（必填，界面上叫「任务组合」）
# ============================================================
# 字段与上游 py12306 的 env.py 一致；可写多个任务。
#   left_dates  乘车日期（可多个，越少越省查询量）
#   stations    车站组合，建议 1~3 组（多买几站有时成功率更高，但查询量成倍增长）
#   seats       席别（二等座/一等座/硬卧/硬座…）
#   members     乘客姓名，必须与 12306 里的常用联系人完全一致
#   period      可选，出发时段，支持跨零点如 {"from":"22:00","to":"06:00"}
QUERY_JOBS_JSON=[{"job_name":"北京到上海","left_dates":["2026-10-01"],"stations":[{"left":"北京","arrive":"上海"}],"seats":["二等座"],"members":["张三"]}]

# ============================================================
# 3) 安全（必填，否则不允许启动）
# ============================================================
# 登录态落盘加密口令（>=16 字符）。runtime/user 下存的是能直接下单的 cookie。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
RUNTIME_ENC_KEY=

# Web 面板的 JWT 密钥（要用面板时必填，>=32 字符）
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# 明文登录态（不推荐，仅调试）
# ALLOW_PLAINTEXT_STATE=0

# ============================================================
# 4) 查询节奏与风控（界面「设置」页也能改，这里改了会覆盖界面值）
# ============================================================
QUERY_INTERVAL=4               # 基础间隔秒，建议 3~5；每次请求带 ±30% 抖动
MAX_STATION_PAIRS=5            # 车站组合上限
PRE_SALE_WINDOW_MINUTES=60     # 开售前多久进入激进窗口
RISK_FAILURE_THRESHOLD=3       # 连续 N 次异常进入退避
RISK_BREAKER_BASE=30           # 熔断首次等待（秒）
RISK_BREAKER_CAP=1800          # 熔断上限（秒）
RISK_BREAKER_MULTIPLIER=2      # 熔断等待指数倍率
RISK_JITTER_RATIO=0.2          # 退避/熔断等待的抖动比例

# 12306 每天凌晨维护（约 23:30-05:00）。桌面程序里想立刻试可以打开这个开关：
# IGNORE_MARKET_HOURS=1

# ============================================================
# 5) 告警（不填也能用，默认打到控制台/日志）
# ============================================================
NOTIFY_ADAPTERS=console        # console,dingtalk,serverchan,bark,webhook
DINGTALK_WEBHOOK=
DINGTALK_SECRET=               # 加签密钥，可空
DINGTALK_KEYWORD=              # 机器人安全设置里的关键词，可空
SERVERCHAN_KEY=
BARK_URL=
WEBHOOK_URL=
# WEBHOOK_HEADERS_JSON={"Authorization":"Bearer xxx"}

# ============================================================
# 6) 界面与日志
# ============================================================
LOG_LEVEL=INFO
LOG_REDACT=1                   # 关掉会让你在日志里看到明文 cookie/密码，别关
# LOG_REDACT_EXTRA=SEC-\d{8};MYTOKEN-\w+   # 额外脱敏正则
# DEV_MODE=1                   # 放宽部分校验，仅本机排障

# ============================================================
# 7) Web 面板（可选；桌面程序里点「启动 Web 面板」也能起）
# ============================================================
PANEL_BIND=127.0.0.1           # 默认只允许本机访问
PANEL_PORT=8010
# 允许局域网访问（谨慎，界面能看登录态；建议同时设 PANEL_TOKEN）
# PANEL_ALLOW_REMOTE=1
# PANEL_TOKEN=

# ============================================================
# 8) 数据目录（默认在「文档\py12306」，一般不用改）
# ============================================================
# PY12306_DATA_DIR=D:\py12306-data

# ============================================================
# 9) 候补模式（可选，官方渠道，合规性最好）
# ============================================================
# WAITLIST_JSON={"left_date":"2026-10-01","left_station":"北京","arrive_station":"上海","train_numbers":["G1","G3"],"seat_types":["O"],"accept_no_seat":true,"passengers":[{"passenger_name":"张三","passenger_id_no":"11010119900307721X","passenger_id_type_code":"1","passenger_type":"1"}]}
# 候补端点在 12306 没公开文档、路径会变，首次使用请按抓包核对后覆盖：
# WAITLIST_SUBMIT_URL=
# WAITLIST_QUERY_URL=
# WAITLIST_CANCEL_URL=
